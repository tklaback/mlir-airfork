# RUN: PYTHONPATH=%S/../../my_install/python python3 %S/../nki_emitter/air_to_nki.py %s | FileCheck %s
# CHECK: # NKI vector addition kernel
# CHECK: 
# CHECK: import numpy as np
# CHECK: import neuronxcc.nki as nki
# CHECK: import neuronxcc.nki.language as nl
# CHECK: import neuronxcc.nki.isa as nisa
# CHECK: 
# CHECK: @nki.jit
# CHECK: def simple_add(arg0, arg1):
# CHECK:   output = nl.ndarray(arg0.shape, dtype=arg0.dtype, buffer=nl.shared_hbm)
# CHECK:   # Pattern-matched 2D tensor add emitted as tiled NKI kernel
# CHECK:   offset_i_x = nl.program_id(0) * 16
# CHECK:   offset_i_y = nl.program_id(1) * 16
# CHECK:   ix = offset_i_x + nl.arange(16)[:, None]
# CHECK:   iy = offset_i_y + nl.arange(16)[None, :]
# CHECK:   a_tile = nl.load(arg0[ix, iy])
# CHECK:   b_tile = nl.load(arg1[ix, iy])
# CHECK:   c_tile = nisa.tensor_tensor(a_tile, b_tile, op=np.add)
# CHECK:   nl.store(output[ix, iy], value=c_tile)
# CHECK:   return output

#Start:
module {
  func.func @simple_add(%arg0: memref<16x16xf32>, %arg1: memref<16x16xf32>, %arg2: memref<16x16xf32>) {
    %c16 = arith.constant 16 : index
    %c1 = arith.constant 1 : index
    %c0 = arith.constant 0 : index
    scf.for %arg3 = %c0 to %c16 step %c1 {
      scf.for %arg4 = %c0 to %c16 step %c1 {
        %0 = memref.load %arg0[%arg3, %arg4] : memref<16x16xf32>
        %1 = memref.load %arg1[%arg3, %arg4] : memref<16x16xf32>
        %2 = arith.addf %0, %1 : f32
        memref.store %2, %arg2[%arg3, %arg4] : memref<16x16xf32>
      }
    }
    return
  }
}

